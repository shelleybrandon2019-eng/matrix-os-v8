# Copy this file to config.env and fill in your live-data settings.
MATRIX_FULLSCREEN=1
MATRIX_UPDATE_SECONDS=20
MATRIX_PAGE_SECONDS=8

# Ecowitt cloud API
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# Govee Bluetooth sensors
FRONT_ROOM_MAC=A4:C1:38:21:0C:F2
BEDROOM_MAC=A4:C1:38:17:EC:09

# Optional HTTP temperature fallbacks
FRONT_ROOM_URL=
BEDROOM_URL=

# Optional 75% Matrix / 25% Tapo camera panel.
# Keep all camera details only in local config.env; never commit them.
TAPO_CAMERA_ENABLED=0
TAPO_CAMERA_HOST=
TAPO_CAMERA_USER=
TAPO_CAMERA_PASSWORD=
TAPO_CAMERA_STREAM=stream2
